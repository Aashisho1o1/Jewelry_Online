{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "vite --port 3001",
  "framework": null,
  "regions": ["sin1"],
  "crons": [
    { "path": "/api/metal-rates/sync", "schedule": "30 5 * * *" }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Content-Security-Policy": "frame-ancestors 'none'",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(self)"
      },
      "continue": true
    },
    {
      "src": "/(?!api/)(.*)",
      "has": [{ "type": "host", "value": "www.aashishjewellers.com.np" }],
      "headers": { "Location": "https://aashishjewellers.com.np/$1" },
      "status": 308
    },
    { "src": "/api/orders/(.*)", "dest": "/api/orders" },
    { "src": "/api/products/(.*)", "dest": "/api/products" },
    { "src": "/api/reviews(.*)", "dest": "/api/products" },
    { "src": "/api/payments/(.*)", "dest": "/api/payments" },
    { "src": "/api/carts/(.*)", "dest": "/api/carts" },
    { "src": "/api/promos/(.*)", "dest": "/api/promos" },
    { "src": "/api/rates", "dest": "/api/metal-rates" },
    { "src": "/api/metal-rates/(.*)", "dest": "/api/metal-rates" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/api/payments/esewa/success", "dest": "/api/payments" },
    { "src": "/api/payments/esewa/failure", "dest": "/api/payments" },
    { "src": "/sitemap.xml", "dest": "/api/sitemap" },
    { "handle": "filesystem" },
    { "src": "/.*\.(png|jpe?g|webp|svg|ico|gif)", "status": 404 },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
